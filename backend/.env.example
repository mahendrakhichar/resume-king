# ==============================================================================
# ResumeForge AI - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your credentials.
# In local development, you only need OPENROUTER_API_KEY and DATABASE_URL.

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Use postgresql+asyncpg:// for async SQLAlchemy)
# Example local: postgresql+asyncpg://postgres:postgres@localhost:5432/resumeforge
# Example Neon:  postgresql+asyncpg://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumeforge

# ------------------------------------------------------------------------------
# 2. OpenRouter AI (Primary Unified Gateway)
# ------------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Multi-Tier LLM Task Routing (Customize model IDs as desired)
HEAVY_MODEL=google/gemma-4-31b
MAIN_MODEL=groq/llama-3.3-70b-versatile
FAST_MODEL=groq/llama-3.1-8b-instant
FALLBACK_MODEL=minimax/minimax-m2.5:free

# ------------------------------------------------------------------------------
# 3. Direct AI Providers (Optional Fallbacks)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_optional
GROQ_API_KEY=your_groq_api_key_optional
OPENAI_API_KEY=your_openai_api_key_optional
NVIDIA_API_KEY=your_nvidia_api_key_optional

# ------------------------------------------------------------------------------
# 4. Authentication (Clerk)
# ------------------------------------------------------------------------------
# For local dev mock mode, leave these as default placeholders.
# For production, obtain keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 5. Storage & Vector DB
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CHROMA_PERSIST_DIR=./chroma_db

# ------------------------------------------------------------------------------
# 6. Server & App Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
